# Copy this file to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to version control

[database]
host = "your-database-host.example.com"
port = 5432
database = "your_database_name"
username = "your_username"
password = "your_secure_password"

[api]
api_key = "your_api_key_here"
endpoint = "https://api.example.com"

[connections]
clickhouse_host = "clickhouse.example.com"
clickhouse_port = 8123
clickhouse_user = "default"
clickhouse_password = ""
clickhouse_database = "analytics"

[mongodb]
connection_string = "mongodb://username:password@host:27017"
database_name = "your_mongo_db"
